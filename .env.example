# Copy to .env to run CDM against a real HubSpot developer/test portal instead of the mock.
# Private app scopes: crm.objects.{contacts,companies,deals}.read/write, crm.schemas.{contacts,companies,deals}.write
HUBSPOT_BASE_URL=https://api.hubapi.com
HUBSPOT_ACCESS_TOKEN=pat-eu1-xxxxxxxx
# App client secret, used to verify webhook signatures (v3).
HUBSPOT_CLIENT_SECRET=xxxxxxxx

# Mock only: percentage of HubSpot calls answered with 429 to exercise retry/backoff.
MOCK_RATE_LIMIT_PERCENT=0
